<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Experiment 3 - Tailwind CSS Responsive Design</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
    <!-- Header/Navbar -->
    <header class="bg-gray-900 text-white shadow-md sticky top-0 z-50">
        <nav class="max-w-6xl mx-auto flex justify-between items-center px-4 sm:px-6 md:px-8 py-4">
            <div class="text-2xl md:text-3xl font-bold tracking-wide">FitLife</div>
            
            <!-- Desktop Navigation -->
            <div class="hidden md:flex gap-8">
                <a href="#" class="hover:text-blue-400 transition duration-300 font-medium">Home</a>
                <a href="#" class="hover:text-blue-400 transition duration-300 font-medium">Programs</a>
                <a href="#" class="hover:text-blue-400 transition duration-300 font-medium">Trainers</a>
                <a href="#" class="hover:text-blue-400 transition duration-300 font-medium">Contact</a>
            </div>
            
            <!-- Mobile Menu Button -->
            <button id="mobileMenuBtn" class="md:hidden text-white focus:outline-none">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </nav>
        
        <!-- Mobile Navigation Links -->
        <div id="mobileMenu" class="hidden md:hidden px-4 sm:px-6 pb-4 space-y-2 bg-gray-800">
            <a href="#" class="block py-2 hover:text-blue-400 transition duration-300 font-medium">Home</a>
            <a href="#" class="block py-2 hover:text-blue-400 transition duration-300 font-medium">Programs</a>
            <a href="#" class="block py-2 hover:text-blue-400 transition duration-300 font-medium">Trainers</a>
            <a href="#" class="block py-2 hover:text-blue-400 transition duration-300 font-medium">Contact</a>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-blue-500 via-blue-500 to-blue-700 text-white py-16 sm:py-20 md:py-28 px-4 sm:px-6 md:px-8">
        <div class="max-w-4xl mx-auto text-center">
            <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-4 md:mb-6 leading-tight">Transform Your Body & Mind</h1>
            <p class="text-lg sm:text-xl md:text-2xl mb-8 md:mb-10 font-light opacity-95">
                Join FitLife today and achieve your fitness goals with expert trainers.
            </p>
            <button class="bg-white text-blue-600 px-8 md:px-10 py-3 md:py-4 rounded-lg font-bold hover:bg-gray-100 transition duration-300 transform hover:scale-105">
                Join Now
            </button>
        </div>
    </section>

    <!-- Programs Section -->
    <section class="py-16 sm:py-20 md:py-24 px-4 sm:px-6 md:px-8">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-center mb-4 text-gray-900">Our Programs</h2>
            <p class="text-center text-gray-600 mb-12 md:mb-16 text-base md:text-lg">
                Choose from our wide range of fitness programs designed for all levels
            </p>
            
            <!-- Programs Grid - Responsive: 1 column on mobile, 2 on tablet, 3 on desktop -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
                
                <!-- Program Card 1: Weight Training -->
                <div class="bg-white rounded-lg shadow-md hover:shadow-xl transition duration-300 transform hover:-translate-y-1 overflow-hidden border-l-4 border-red-500 p-6 md:p-8">
                    <div class="mb-4">
                        <div class="inline-block bg-red-100 p-3 rounded-lg">
                            <svg class="w-6 h-6 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M10.5 1.5H9.5v3h1v-3zm0 12h-1v3h1v-3zM4.5 9.5h-3v1h3v-1zm12 0h-3v1h3v-1z"/>
                            </svg>
                        </div>
                    </div>
                    <h3 class="text-xl md:text-2xl font-bold text-red-500 mb-3">Weight Training</h3>
                    <p class="text-gray-700 leading-relaxed">Build strength and muscle with guided weight training programs designed for all fitness levels.</p>
                </div>

                <!-- Program Card 2: Yoga Classes -->
                <div class="bg-white rounded-lg shadow-md hover:shadow-xl transition duration-300 transform hover:-translate-y-1 overflow-hidden border-l-4 border-red-500 p-6 md:p-8">
                    <div class="mb-4">
                        <div class="inline-block bg-red-100 p-3 rounded-lg">
                            <svg class="w-6 h-6 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M10 1a4 4 0 110 8 4 4 0 010-8zm0 1a3 3 0 100 6 3 3 0 000-6zm7 8a1 1 0 11-2 0 1 1 0 012 0zm-7 4a4 4 0 00-4 4v2h8v-2a4 4 0 00-4-4z"/>
                            </svg>
                        </div>
                    </div>
                    <h3 class="text-xl md:text-2xl font-bold text-red-500 mb-3">Yoga Classes</h3>
                    <p class="text-gray-700 leading-relaxed">Improve flexibility and mental wellness through peaceful yoga sessions and meditation techniques.</p>
                </div>

                <!-- Program Card 3: Diet Plans -->
                <div class="bg-white rounded-lg shadow-md hover:shadow-xl transition duration-300 transform hover:-translate-y-1 overflow-hidden border-l-4 border-red-500 p-6 md:p-8">
                    <div class="mb-4">
                        <div class="inline-block bg-red-100 p-3 rounded-lg">
                            <svg class="w-6 h-6 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zm0 6a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zm10 0a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>
                            </svg>
                        </div>
                    </div>
                    <h3 class="text-xl md:text-2xl font-bold text-red-500 mb-3">Diet Plans</h3>
                    <p class="text-gray-700 leading-relaxed">Personalized nutrition guidance and meal plans to complement your fitness routine and goals.</p>
                </div>

            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white py-8 md:py-12 px-4 sm:px-6 md:px-8 mt-12">
        <div class="max-w-6xl mx-auto">
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 mb-8 text-center sm:text-left">
                <div>
                    <h4 class="font-bold mb-2">FitLife</h4>
                    <p class="text-gray-400 text-sm">Your fitness journey starts here.</p>
                </div>
                <div>
                    <h4 class="font-bold mb-2">Quick Links</h4>
                    <p class="text-gray-400 text-sm">Home | Programs | Trainers | Contact</p>
                </div>
                <div>
                    <h4 class="font-bold mb-2">Contact</h4>
                    <p class="text-gray-400 text-sm">info@fitlife.com</p>
                </div>
            </div>
            <div class="border-t border-gray-800 pt-8 text-center">
                <p class="text-gray-400 text-sm">© 2026 FitLife. All Rights Reserved</p>
            </div>
        </div>
    </footer>

    <script>
        // Mobile menu toggle
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });
    </script>

</body>
</html>
