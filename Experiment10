public class BankManagementSystem {
    
    public static void main(String[] args) {
        
        System.out.println("\n╔════════════════════════════════════════════════╗");
        System.out.println("║    BANK MANAGEMENT SYSTEM - OOP CONCEPTS       ║");
        System.out.println("╚════════════════════════════════════════════════╝");
        
        // Step 1: Create a SavingsAccount object
        System.out.println("\n\n--- CREATING SAVINGS ACCOUNT ---");
        SavingsAccount savingsAccount = new SavingsAccount("SA001", "Raj Kumar", 50000.0);
        savingsAccount.displayAccountDetails();
        
        // Step 2: Perform operations on Savings Account
        System.out.println("\n--- SAVINGS ACCOUNT OPERATIONS ---");
        savingsAccount.deposit(10000);
        System.out.println();
        savingsAccount.withdraw(5000);
        System.out.println();
        savingsAccount.addInterest();
        
        // Display updated details
        System.out.println();
        savingsAccount.displayAccountDetails();
        
        
        // Step 3: Create a CurrentAccount object
        System.out.println("\n\n--- CREATING CURRENT ACCOUNT ---");
        CurrentAccount currentAccount = new CurrentAccount("CA001", "Priya Singh", 100000.0);
        currentAccount.displayAccountDetails();
        
        // Step 4: Perform operations on Current Account
        System.out.println("\n--- CURRENT ACCOUNT OPERATIONS ---");
        currentAccount.deposit(25000);
        System.out.println();
        currentAccount.withdraw(15000);
        System.out.println();
        currentAccount.addInterest();
        System.out.println();
        currentAccount.deductMonthlyCharges();
        
        // Display updated details
        System.out.println();
        currentAccount.displayAccountDetails();
        
        
        // Step 5: Demonstrate Encapsulation - Using getters and setters
        System.out.println("\n\n--- DEMONSTRATING ENCAPSULATION ---");
        System.out.println("Savings Account Holder: " + savingsAccount.getAccountHolderName());
        System.out.println("Current Balance: " + savingsAccount.getBalance());
        System.out.println("Savings Interest Rate: 4%");
        System.out.println();
        System.out.println("Current Account Holder: " + currentAccount.getAccountHolderName());
        System.out.println("Current Balance: " + currentAccount.getBalance());
        System.out.println("Current Interest Rate: 2%");
        
        
        // Step 6: Demonstrate Abstraction - Abstract method implementation
        System.out.println("\n\n--- DEMONSTRATING ABSTRACTION ---");
        System.out.println("SavingsAccount Interest (Abstract method implementation):");
        System.out.println("  Annual Interest: " + savingsAccount.calculateInterest());
        System.out.println();
        System.out.println("CurrentAccount Interest (Abstract method implementation):");
        System.out.println("  Annual Interest: " + currentAccount.calculateInterest());
        
        
        // Step 7: Demonstrate Inheritance
        System.out.println("\n\n--- DEMONSTRATING INHERITANCE ---");
        System.out.println("Both SavingsAccount and CurrentAccount inherit from BankAccount");
        System.out.println("They use inherited methods: deposit(), withdraw(), displayAccountDetails()");
        System.out.println();
        System.out.println("SavingsAccount is-a BankAccount: " + (savingsAccount instanceof BankAccount));
        System.out.println("CurrentAccount is-a BankAccount: " + (currentAccount instanceof BankAccount));
        
        
        // Final Summary
        System.out.println("\n\n╔════════════════════════════════════════════════╗");
        System.out.println("║              FINAL ACCOUNT SUMMARY              ║");
        System.out.println("╚════════════════════════════════════════════════╝");
        
        savingsAccount.displayAccountDetails();
        currentAccount.displayAccountDetails();
        
        System.out.println("\n Program completed successfully!");
        System.out.println("\nOOP CONCEPTS DEMONSTRATED:");
        System.out.println("  1. Encapsulation: Private variables with getter/setter methods");
        System.out.println("  2. Inheritance: SavingsAccount and CurrentAccount extend BankAccount");
        System.out.println("  3. Abstraction: calculateInterest() abstract method implemented in subclasses");
        System.out.println("\n");
    }
}


