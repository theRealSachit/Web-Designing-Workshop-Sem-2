// CurrentAccount class - Inheritance
// Extends BankAccount and implements calculateInterest()

public class CurrentAccount extends BankAccount {
    
    private static final double INTEREST_RATE = 0.02; // 2% annual interest rate
    private double monthlyCharges = 100.0; // Monthly service charge
    
    // Constructor
    public CurrentAccount(String accountNumber, String accountHolderName, double initialBalance) {
        super(accountNumber, accountHolderName, initialBalance);
    }
    
    // Implementation of abstract method calculateInterest()
    @Override
    public double calculateInterest() {
        double interest = getBalance() * INTEREST_RATE;
        return interest;
    }
    
    // Method to deduct monthly charges
    public void deductMonthlyCharges() {
        withdraw(monthlyCharges);
        System.out.println("✓ Monthly Charges Deducted: ₹" + monthlyCharges);
    }
    
    // Method to add interest to the account
    public void addInterest() {
        double interest = calculateInterest();
        deposit(interest);
        System.out.println("✓ Interest Added: ₹" + interest);
    }
    
    // Getter for monthly charges
    public double getMonthlyCharges() {
        return monthlyCharges;
    }
    
    // Setter for monthly charges
    public void setMonthlyCharges(double charges) {
        this.monthlyCharges = charges;
    }
    
    // Override displayAccountDetails to show account type
    @Override
    public void displayAccountDetails() {
        super.displayAccountDetails();
        System.out.println("Account Type: Current Account");
        System.out.println("Interest Rate: " + (INTEREST_RATE * 100) + "%");
        System.out.println("Annual Interest: ₹" + calculateInterest());
        System.out.println("Monthly Charges: ₹" + monthlyCharges);
        System.out.println("=====================================");
    }
}

