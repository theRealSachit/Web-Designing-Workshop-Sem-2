<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Information - React JSX Props</title>
    <style>
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f2f7fb;
        color: #1f2937;
      }

      .page-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }

      .app-card {
        width: min(720px, 100%);
        background: white;
        border-radius: 24px;
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.12);
        padding: 32px;
      }

      h1 {
        margin: 0 0 10px;
        font-size: 2rem;
        text-align: center;
      }

      .description {
        margin: 0 0 24px;
        text-align: center;
        color: #4b5563;
      }

      .student-list {
        display: grid;
        gap: 18px;
      }

      .student-card {
        padding: 22px 24px;
        border-radius: 18px;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
      }

      .student-card h2 {
        margin: 0 0 10px;
        font-size: 1.3rem;
      }

      .student-card p {
        margin: 6px 0;
        color: #374151;
      }

      .student-card strong {
        color: #111827;
      }

      .footer {
        margin-top: 28px;
        text-align: center;
        color: #6b7280;
        font-size: 0.95rem;
      }

      .student-form {
        display: grid;
        gap: 12px;
        margin-bottom: 28px;
      }

      .student-form input {
        width: 100%;
        padding: 12px 14px;
        border-radius: 12px;
        border: 1px solid #d1d5db;
        font-size: 1rem;
        color: #111827;
        background: #ffffff;
      }

      .student-form button {
        width: 100%;
        padding: 12px 14px;
        border-radius: 12px;
        border: none;
        background: #2563eb;
        color: white;
        font-size: 1rem;
        cursor: pointer;
      }

      .student-form button:hover {
        background: #1d4ed8;
      }
    </style>
  </head>
  <body>
    <div id="root" class="page-wrapper"></div>

    <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

    <script type="text/babel">
      const { useState } = React;

      function Student({ name, course, marks }) {
        return (
          <div className="student-card">
            <h2>{name}</h2>
            <p>
              <strong>Course:</strong> {course}
            </p>
            <p>
              <strong>Marks:</strong> {marks}
            </p>
          </div>
        );
      }

      function App() {
        const [students, setStudents] = useState([
        ]);

        const [formData, setFormData] = useState({ name: '', course: '', marks: '' });

        function handleInputChange(event) {
          const { name, value } = event.target;
          setFormData((prev) => ({ ...prev, [name]: value }));
        }

        function handleSubmit(event) {
          event.preventDefault();
          if (!formData.name.trim() || !formData.course.trim() || !formData.marks.trim()) {
            return;
          }

          const newStudent = {
            id: Date.now(),
            name: formData.name,
            course: formData.course,
            marks: Number(formData.marks)
          };

          setStudents((prev) => [...prev, newStudent]);
          setFormData({ name: '', course: '', marks: '' });
        }

        return (
          <div className="app-card">
            <h1>Student Information</h1>
            <p className="description">
              This example uses React JSX and props to render reusable student components.
            </p>

            <form className="student-form" onSubmit={handleSubmit}>
              <input
                type="text"
                name="name"
                placeholder="Student Name"
                value={formData.name}
                onChange={handleInputChange}
              />
              <input
                type="text"
                name="course"
                placeholder="Course"
                value={formData.course}
                onChange={handleInputChange}
              />
              <input
                type="number"
                name="marks"
                placeholder="Marks"
                value={formData.marks}
                onChange={handleInputChange}
              />
              <button type="submit">Add Student</button>
            </form>

            <div className="student-list">
              {students.map((student) => (
                <Student
                  key={student.id}
                  name={student.name}
                  course={student.course}
                  marks={student.marks}
                />
              ))}
            </div>
            <div className="footer">
              Reusable React components display dynamic data via props.
            </div>
          </div>
        );
      }

      const root = ReactDOM.createRoot(document.getElementById('root'));
      root.render(<App />);
    </script>
  </body>
</html>

